<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pp_gray">

    <!-- ── Toolbar ──────────────────────────────────────────────────────────── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pp_green"
        android:elevation="6dp"
        app:titleTextColor="@color/pp_white"
        app:navigationIconTint="@color/pp_white"/>

    <!-- ── Contenido ────────────────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══════════════════════════════════
                 CARD 1: Ingresar código
                 ═══════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/pp_white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:text="🔍"
                            android:textSize="20sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:text="Buscar Producto"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/pp_text_dark"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Botón Escanear -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEscanear"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="📷   Escanear Código de Barras"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pp_green"
                        android:textColor="@color/pp_white"
                        app:cornerRadius="10dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Separador visual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/pp_divider"/>

                        <TextView
                            android:text="  o ingresa manualmente  "
                            android:textSize="12sp"
                            android:textColor="@color/pp_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/pp_divider"/>
                    </LinearLayout>

                    <!-- Input código manual -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Código del producto"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/pp_green"
                        app:hintTextColor="@color/pp_green"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCodigoManual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:textColor="@color/pp_text_dark"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón buscar manual -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuscarManual"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Buscar Producto"
                        android:textSize="14sp"
                        app:backgroundTint="@color/pp_green_light"
                        android:textColor="@color/pp_green"
                        app:strokeColor="@color/pp_green"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    <!-- Progress buscando -->
                    <ProgressBar
                        android:id="@+id/progressBuscar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:indeterminateTint="@color/pp_green"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════════════
                 CARD 2: Producto encontrado
                 ═══════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/pp_white"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Badge: Producto Encontrado -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/pp_green_light"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:text="✅"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:text="Producto Encontrado"
                            android:textSize="12sp"
                            android:textColor="@color/pp_green_dark"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Nombre del producto -->
                    <TextView
                        android:id="@+id/tvNombreProducto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/pp_text_dark"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <!-- Código y Unidad de medida en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvIdProducto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/pp_text_secondary"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/tvUnidadMedida"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/pp_text_secondary"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Stock del sistema -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="@color/pp_green_light"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="14dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:text="📊"
                                android:textSize="18sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"/>

                            <TextView
                                android:id="@+id/tvStockSistema"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Stock en sistema: —"
                                android:textSize="15sp"
                                android:textColor="@color/pp_green_dark"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/pp_divider"
                        android:layout_marginBottom="16dp"/>

                    <!-- Título cantidad -->
                    <TextView
                        android:text="Cantidad contada físicamente"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/pp_text_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"/>

                    <!-- Input cantidad -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingresa la cantidad"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/pp_green"
                        app:hintTextColor="@color/pp_green"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCantidadContada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="20sp"
                            android:textColor="@color/pp_text_dark"
                            android:gravity="center"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón registrar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegistrar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="REGISTRAR INVENTARIO"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/pp_white"
                        app:backgroundTint="@color/pp_green"
                        app:cornerRadius="10dp"
                        android:elevation="2dp"/>

                    <!-- Progress registrando -->
                    <ProgressBar
                        android:id="@+id/progressRegistrar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:indeterminateTint="@color/pp_green"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>