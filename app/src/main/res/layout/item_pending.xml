<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/pp_white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- ── Icono visual de "Pendiente" ── -->
        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⏳"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@drawable/shape_circle_white"
            android:backgroundTint="@color/pp_warning_light"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ── Producto ── -->
            <TextView
                android:id="@+id/tvProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Producto"
                android:textColor="@color/pp_text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- ── Almacén ── -->
            <TextView
                android:id="@+id/tvAlmacen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Almacén: —"
                android:textColor="@color/pp_text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <!-- ── Cantidad (En color naranja para destacar) ── -->
                <TextView
                    android:id="@+id/tvCantidad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cantidad: 0"
                    android:textColor="@color/pp_warning"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ── Fecha ── -->
                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:30"
                    android:textColor="@color/pp_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>