<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivLogoAnimado"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/logo_pp_blanco"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Procesadora Perú S.A.C."
            android:textColor="@color/pp_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="24dp" /> <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión Inteligente de Inventario"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        android:letterSpacing="0.05"
        android:layout_marginTop="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="Versión 2.0"
        android:textColor="#88FFFFFF"
        android:textSize="12sp" />

</FrameLayout>