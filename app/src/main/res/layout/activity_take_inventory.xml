<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/take_inventory_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_background"
    android:fitsSystemWindows="true">

    <!--
        CORRECCIÓN SAFE AREA:
        android:fitsSystemWindows="true" en AppBarLayout hace que la barra de
        estado sea respetada automáticamente. El icono de retroceso ya no
        aparecerá detrás/encima de la barra de notificaciones.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/pp_green"
            app:title="Toma de Inventario"
            app:titleCentered="true"
            app:titleTextColor="@color/pp_white"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/pp_white"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card: Buscar Producto -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.CardView.Elevated"
                app:cardCornerRadius="20dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/pp_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEscanear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Inventario.Button"
                        android:text="Escanear Código QR / Barras"
                        app:icon="@drawable/ic_camera"
                        android:layout_marginBottom="20dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Código manual"
                        style="@style/Widget.Inventario.TextInputLayout"
                        app:startIconDrawable="@drawable/ic_barcode"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCodigoManual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:textColor="@color/pp_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuscarManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:text="Buscar Producto"
                        android:textColor="@color/pp_green"/>

                    <ProgressBar
                        android:id="@+id/progressBuscar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/pp_green"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Detalle del Producto -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.CardView.Elevated"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/pp_surface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvNombreProducto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre del Producto"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/pp_text_primary"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvIdProducto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Código: 000"
                        android:textColor="@color/pp_text_secondary"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tvStockSistema"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock actual: 0.0"
                        android:textStyle="bold"
                        android:textColor="@color/pp_green"
                        android:background="@color/pp_green_light"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="24dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cantidad contada"
                        style="@style/Widget.Inventario.TextInputLayout"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCantidadContada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/pp_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegistrar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Inventario.Button"
                        android:text="REGISTRAR CONTEO"/>

                    <ProgressBar
                        android:id="@+id/progressRegistrar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/pp_green"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>