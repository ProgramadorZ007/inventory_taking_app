<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Animación Lottie Modernizada -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieView"
            android:layout_width="280dp"
            android:layout_height="280dp"
            app:lottie_rawRes="@raw/pp_splash"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            app:lottie_speed="1.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Procesadora Perú S.A.C."
            android:textColor="@color/pp_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión Inteligente de Inventario"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="Versión 2.0"
        android:textColor="#88FFFFFF"
        android:textSize="12sp" />

</FrameLayout>