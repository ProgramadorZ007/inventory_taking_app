<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ════════════════════════════════════
         CONTENIDO PRINCIPAL
         ════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/pp_gray">

        <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/pp_green"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:text="Inventario PP"
                    android:textColor="@color/pp_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvToolbarSubtitle"
                    android:text="Cargando ubicación…"
                    android:textColor="#CCffffff"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- ── Contenido scrollable ─────────────────────────────────────────── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ── HERO CARD: Toma de inventario ─────────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/pp_green"
                        android:padding="28dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:text="📦"
                            android:textSize="52sp"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"/>

                        <TextView
                            android:text="Toma de Inventario"
                            android:textColor="@color/pp_white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:text="Escanea o ingresa el código del producto para registrar el conteo físico"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRealizarToma"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:text="INICIAR TOMA"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:paddingStart="36dp"
                            android:paddingEnd="36dp"
                            app:backgroundTint="@color/pp_white"
                            android:textColor="@color/pp_green"
                            app:cornerRadius="26dp"
                            android:elevation="3dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── TÍTULO sección accesos rápidos ────────────────────────── -->
                <TextView
                    android:text="Accesos rápidos"
                    android:textSize="13sp"
                    android:textColor="@color/pp_text_secondary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="2dp"/>

                <!-- ── ROW de shortcuts ───────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <!-- Card Historial -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardHistorial"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="@color/pp_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:text="📋"
                                android:textSize="30sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Mis Registros"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/pp_text_dark"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"/>

                            <TextView
                                android:text="Ver inventarios de hoy"
                                android:textSize="10sp"
                                android:textColor="@color/pp_text_secondary"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card Pendientes -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPendientes"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="@color/pp_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:text="⏳"
                                android:textSize="30sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Pendientes"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/pp_warning"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"/>

                            <TextView
                                android:text="Sin conexión"
                                android:textSize="10sp"
                                android:textColor="@color/pp_text_secondary"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- ── Información de la app ──────────────────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/pp_green_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:text="ℹ️"
                            android:textSize="20sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="App funciona sin internet"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/pp_green_dark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Los registros pendientes se envían automáticamente al recuperar la conexión"
                                android:textSize="11sp"
                                android:textColor="@color/pp_green"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ════════════════════════════════════
         NAVIGATION DRAWER
         ════════════════════════════════════ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@layout/nav_menu"
        app:itemIconTint="@color/pp_green"
        app:itemTextColor="@color/pp_text_dark"
        app:itemIconSize="24dp"/>

</androidx.drawerlayout.widget.DrawerLayout>