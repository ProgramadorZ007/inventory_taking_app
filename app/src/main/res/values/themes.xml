<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Inventario" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pp_splash_text_green</item>
        <item name="colorOnPrimary">@color/pp_white</item>
        <item name="colorSecondary">@color/pp_green_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Inventario.Splash" parent="Theme.SplashScreen">
        <!-- Usar el mismo fondo que el splash personalizado para eliminar cualquier flash -->
        <item name="windowSplashScreenBackground">@color/pp_splash_text_green</item>
        <!-- Sin ícono animado del sistema -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <!-- Transición inmediata al contenido de tu SplashActivity -->
        <item name="postSplashScreenTheme">@style/Theme.Inventario</item>
        <!-- La ventana usa directamente el fondo del splash para cero transición visible -->
        <item name="android:windowBackground">@drawable/fondo</item>
    </style>

    <style name="Widget.Inventario.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Inventario.MediumComponent</item>
        <item name="android:stateListAnimator" tools:ignore="NewApi">@null</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Inventario.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/pp_splash_text_green</item>
        <item name="hintTextColor">@color/pp_splash_text_green</item>
        <item name="startIconTint">@color/pp_splash_text_green</item>
    </style>

    <style name="ShapeAppearance.Inventario.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.Inventario.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>